{
  "name": "@javimolina/rexpi",
  "version": "0.3.0",
  "description": "Tiny arms, many panes. A Pi extension for Rex to multiplex the world.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/javiermolinar/rexpi.git"
  },
  "author": "Javi Molina",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "rex",
    "terminal"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node scripts/test-selection.mjs all",
    "test:orchestration": "node scripts/test-selection.mjs orchestration",
    "test:agents-ui": "node scripts/test-selection.mjs agents-ui",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "pack:check": "node scripts/check-package.mjs",
    "prepublishOnly": "npm test && npm run typecheck && npm run pack:check"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "extensions/",
    "lib/",
    "README.md",
    "CHANGELOG.md",
    "assets/rexpi.jpg",
    "assets/agents.png",
    "assets/worktrees.png",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@types/node": "^22.19.0",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  }
}
