{
  "name": "pi-rex",
  "version": "0.1.0",
  "description": "Pi-aware launches and conversation navigation for Rex",
  "author": "Javi Molina",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "rex",
    "terminal"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "files": [
    "extensions/",
    "lib/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@types/node": "^22.19.0",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  }
}
